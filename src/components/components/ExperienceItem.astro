---
interface Props{
    dateStart: string
    dateEnd: string
    status: boolean
    duration: string
    description: string
    title: string
    workplace: string
}


const {dateStart, dateEnd, status, duration, description, title, workplace} = Astro.props;

const paragraphsDescription = description.split(".").map(phrase => phrase.trim()).filter(phrase => phrase.length > 0)
---

 <li data-aos="fade-up" data-aos-duration="2000"  class="mb-10 ms-5">            
        <span class="absolute flex items-center justify-center size-8 rounded-full -inset-s-9 ring-1 ring-blue-100/70  bg-[#eeebff]/10 backdrop-blur-3xl border">
            <svg class="size-6 text-blue-100/70" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 10h16m-8-3V4M7 7V4m10 3V4M5 20h14a1 1 0 0 0 1-1V7a1 1 0 0 0-1-1H5a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1Zm3-7h.01v.01H8V13Zm4 0h.01v.01H12V13Zm4 0h.01v.01H16V13Zm-8 4h.01v.01H8V17Zm4 0h.01v.01H12V17Zm4 0h.01v.01H16V17Z"/></svg>
        </span>
        <article class="pl-5">
            <div>
                <time class="mr-2 bg-[#eeebff]/10  border border-blue-100/70 text-heading text-xs font-medium px-2 py-1 rounded-lg">{dateStart}</time>
                <span class="text-blue-100/70">-</span>
                <time class="ml-2 bg-[#eeebff]/10  border border-blue-100/70 text-heading text-xs font-medium px-2 py-1 rounded-lg">{dateEnd}</time>
                <span class="ml-2 text-blue-100/70 text-xs">{duration}</span>
            </div>
            <h3 class="flex items-center mb-1 text-lg font-semibold text-heading my-2">{title}
                {workplace && ( <span class="ml-1 text-blue-100/60 tex">-{workplace}</span> )}
                
                {status && (<span class="ms-2 bg-blue-300/30 border border-blue-100/70 text-fg-brand-strong text-xs font-medium px-1.5 py-0.5 rounded">Último</span>) }
                
            </h3>
            <ul class="mb-4 text-body text-pretty">
                {paragraphsDescription.map(phrase => 
                    <li class="mt-2">{phrase}.</li>
                )
                
                }

            </ul>

        </article>
    </li>
