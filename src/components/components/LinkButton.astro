---
    const {id, href, description} = Astro.props    
    import  ToolTip  from "./ToolTip.astro";
---
<div class="absolute">
    <a aria-label=`Información complementaria del proyecto número - ${id}` data-tooltip-target=`tooltip-animation-${id}` href={href} target="_blank." class="text-lg rounded-full flex justify-center items-center p-2 bg-[#eeebff]/10 backdrop-blur-3xl border border-blue-100/70  md:hover:scale-125 hover:bg-blue-100/20 transition hover:cursor-pointer">
        <slot></slot>
    </a>
    <ToolTip description={description} id={id}></ToolTip>
</div>

