---

import { ContactDetailsReveal } from "../microkit/contact-details-reveal";
import  LenguageSelector  from "../components/LenguageSelector.astro";
import ThemeToggle  from "../components/ThemeToggle.astro";


const languages = [
    {code:"en"},
    {code:"es"},
]
const currentLocale = Astro.currentLocale ?? "es";
---

<script>
    const nav = document.getElementById('nav');
    const boton = document.getElementById('boton');

    boton?.addEventListener('click', function() {
        nav?.classList.toggle('hidden');
    });

    const links = document.querySelectorAll('.link');
    links?.forEach(link => {
        link.addEventListener('click',function(){
            nav?.classList.toggle('hidden');
        });
    });

</script>

<div class="fixed z-50 top-0 hidden sm:flex justify-center w-full text-blue-100/70 ">
    <header class="flex items-center mx-auto mt-6 text-sm gap-5 ">     
        <div class="bg-[#eeebff]/10 backdrop-blur-3xl h-12 w-12 rounded-md flex justify-center items-center">
            <a href="/">
                <img loading="lazy" src="../img/developer/img_developer_navbar.webp" alt="Imagen de David Hernández" class="rounded-full h-8 w-8 object-cover">
            </a>
        </div>
        <nav class="bg-[#eeebff]/10 backdrop-blur-3xl rounded-md flex flex-row justify-center items-center gap-x-10 opacity-8pnp0 px-6 py-1 mx-auto h-12">
            <a href="/#inicio" class="relative after:bg-blue-100/70 after:absolute after:h-0.5 after:w-0 after:-bottom-0.5 after:left-0 hover:after:w-full after:transition-all after:duration-100">Inico</a>
            <a href="/#proyectos" class="relative after:bg-blue-100/70 after:absolute after:h-0.5 after:w-0 after:-bottom-0.5 after:left-0 hover:after:w-full after:transition-all after:duration-100">Proyectos</a>
            <a href="/#sobre-mi" class="relative after:bg-blue-100/70 after:absolute after:h-0.5 after:w-0 after:-bottom-0.5 after:left-0 hover:after:w-full after:transition-all after:duration-100">Sobre mi</a>
            <a href="/#tecnologias" class="relative after:bg-blue-100/70 after:absolute after:h-0.5 after:w-0 after:-bottom-0.5 after:left-0 hover:after:w-full after:transition-all after:duration-100">Tecnologías</a> 
        </nav>
        <div class="bg-[#eeebff]/10 backdrop-blur-3xl h-12 flex justify-center items-center rounded-md px-2 gap-3 w-auto">
            <ThemeToggle></ThemeToggle>
        </div>
        <div class="bg-[#eeebff]/10  flex justify-center items-center rounded-md w-auto">
            <LenguageSelector></LenguageSelector>      
        </div>
        
        <div class="bg-[#eeebff]/10 backdrop-blur-3xl h-12 flex justify-center items-center rounded-md px-2 gap-3 w-auto">
            <ContactDetailsReveal></ContactDetailsReveal>
        </div>
   
    </header>
</div>

