---
import Badge from "../../components/components/Badge.astro";
import Star from "../icons/Star.astro";
import { SocialIconButtons } from "../microkit/social-icon-buttons";
import "../../styles/chrome.css";
import HashTagPill from "../components/HashTagPill.astro";
import "../../styles/momentum.css";
---
<section data-aos="fade-in" data-aos-duration="3000" class="w-11/12 mx-auto  h-screen flex flex-col justify-center">
	<div  class=" flex-col  flex lg:flex-row items-center justify-center  " >
		<div class="w-2/5 flex justify-center">
			<div class="relative flex items-center justify-center">
				<div class="absolute bg-neutral-950 rounded-full p-3 inline-block top-0 right-8 text-white"><Star></Star></div>
				<img loading="lazy" class="h-62 object-cover rounded-full lg:w-62" src="../../img/developer/img_developer_hero.webp" alt="Foto de David Hernández">
			</div>
		</div>
		
		<div class="flex flex-col w-3/5">
			
			<h1 class="text-6xl font-bold text-wrap ">
				<a href="https://www.linkedin.com/in/david-antonio-hern%C3%A1ndez-brito-213a951b8/" target="_blank"
				rel="noopener" class="fx-marble inline">Hey, soy David Hernández </a><span class="inline">👋</span>
			</h1>	
			<h2 class="md:text-xl md:text-balance mt-2 text-blue-100/70 ">
				Desarrollador de Software Freelance con 3 años de experiencia.
			</h2>
			<nav class="flex gap-4 mt-4 flex-wrap justify-start items-end md:flex-row ">
				<SocialIconButtons></SocialIconButtons>
				<Badge>Descargar Curriculum Vitae</Badge>
				
			</nav>
		</div>

	</div>
	<div class="text-xs text-blue-100/70 mr-0 mt-15 marquee-zone w-1/3 mx-auto overflow-hidden ">
		<div class="marquee-track flex gap-5">
			<HashTagPill hashtag="Desarrollador Fullstack"></HashTagPill>
			<HashTagPill hashtag="Prototipado"></HashTagPill>
			<HashTagPill hashtag="Diseño UI"></HashTagPill>
			<HashTagPill hashtag="Diseño UX"></HashTagPill>
			<HashTagPill hashtag="Desarrollador web"></HashTagPill>
		</div>
	</div>
</section>
