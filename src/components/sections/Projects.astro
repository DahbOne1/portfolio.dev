---

{
    PROJECTS.map(project => (
        <article data-aos="fade-up" data-aos-duration="2000"   class="flex-col justify-start items-start lg:flex lg:flex-row mb-30 ">
            <div class="w-7/12 flex gap-5">
                <img loading="lazy" class="object-cover h-80 rounded-2xl shadow-xl shadow-white/10 lg:w-3/12 " src={project.image} alt={`Captura de pantalla del proyecto ${project.image}`}>
                <img loading="lazy" class="object-cover h-00 rounded-2xl shadow-xl shadow-white/10 lg:w-9/12 " src={project.image} alt={`Captura de pantalla del proyecto ${project.image}`}>
            </div>
            <div class="w-5/12 pl-10">
                <h3 class="text-3xl text-blue-300/80 font-semibold">{project.title}</h3>    
                   <ul class="flex gap-2 flex-wrap py-4">
                    {project.tags.map((tag) =>(
                        <li>
                            <span class={`text-[8px] flex items-center gap-2 py-1.5 px-3 rounded-4xl bg-[#eeebff]/10 backdrop-blur-3xl border border-blue-100/70  ${tag.class} `}>
                                <tag.icon></tag.icon> {tag.name}    
                            </span>          
                        </li>
                    ))}
                </ul>
                <p class="text-sm mt-2 text-pretty text-white">{project.description}</p>
                <div class="flex items-start gap-5 mt-5 text-white">
                          {project.github && (
                            <div class="w-10">
                                <LinkButton  id=`${project.id}1` description="Visitar repositorio" href={project.github} >
                                    <Github></Github>
                                </LinkButton>
                            </div>
                            )}     

                   
                    
                        {project.link &&(
                            <div class="w-10">
                                <LinkButton id={project.id} description="Ver Demo" href={project.link}>
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-app-window-filled" width="24" height="24" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M19 4a3 3 0 0 1 3 3v10a3 3 0 0 1 -3 3h-14a3 3 0 0 1 -3 -3v-10a3 3 0 0 1 3 -3zm-12.99 3l-.127 .007a1 1 0 0 0 .117 1.993l.127 -.007a1 1 0 0 0 -.117 -1.993zm3 0l-.127 .007a1 1 0 0 0 .117 1.993l.127 -.007a1 1 0 0 0 -.117 -1.993z" stroke-width="0" fill="currentColor" /></svg>    
                                </LinkButton>
                            </div>
                        )}

                    

                             
                </div>
            </div>
        </article>
    ))

}