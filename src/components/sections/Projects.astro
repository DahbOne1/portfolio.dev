        class: "bg-sky-100/20 text-white",
        icon: TailwindIcon,
    },
    LARAVEL:{
        name: "Laravel",
        class: "bg-sky-100/20 text-white",
        icon: LaravelIcon,
    },
    GIT:{
        name: "GIT",
        class: "bg-sky-100/20 text-white",
        icon: GitIcon,
    },
    PHP:{
        name:"PHP",
        class: "bg-sky-100/20 text-white",
        icon: PhpIcon,
    },
    MYSQL:{
        name:"MySQL",
        class: "bg-sky-100/20 text-white",
        icon: MySQL,
    },
    ASTRO:{
        name: "ASTRO",
