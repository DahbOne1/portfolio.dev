---
import Layout from '../../layouts/Layout.astro';
import SectionContainer from "../../components/SectionContainer.astro";
import BriefCase from "../../components/icons/BriefCase.astro";
import Projects from "../../components/sections/Projects.astro";
import Profile from "../../components/icons/Profile.astro";
import AboutMe from "../../components/sections/AboutMe.astro";
import Tool from "../../components/icons/Tool.astro";
import Hero from '../../components/sections/Hero.astro';

import Technologies from '@/components/sections/Technologies.astro';

---

<Layout 
  title="Porfolio de trabajo de David Hernández - Desarrollador y Programador con 1 año de experiencia como desarrollador de software independiente."
  description="Contrata a David para crear tu sitio web con tecnologias como HTML, CSS, JavaScript">
	<main class="">
		<SectionContainer id="inicio" class="py-28">
			<Hero></Hero>
		</SectionContainer>

		<SectionContainer id="proyectos">
			<h2 class="text-xl font-semibold mb-6 flex gap-x-4 items-center justify-start sm:justify-center sm:text-3xl"> <BriefCase></BriefCase>  Proyectos</h2>
			<Projects>
			</Projects>
			
		</SectionContainer>

		<SectionContainer id="sobre-mi">
			<h2 class="text-xl font-semibold mb-6 flex gap-x-4 items-center justify-start sm:justify-center sm:text-3xl"> <Profile></Profile>  Sobre mi</h2>
			<AboutMe>
			</AboutMe>
		</SectionContainer>

		<SectionContainer id="tecnologias" class="mt-20">
			<h2 class="text-xl font-semibold mb-6 flex gap-x-4 items-center justify-start sm:justify-center sm:text-3xl"><Tool></Tool> Experiencia en Tecnologías</h2>
			<Technologies></Technologies>
		</SectionContainer>
	</main>
	
</Layout>

