---
import Layout from '../../layouts/Layout.astro';
import SectionContainer from "../../components/SectionContainer.astro";
import BriefCase from "../../components/icons/BriefCase.astro";
import Projects from "../../components/sections/Projects.astro";
import Profile from "../../components/icons/Profile.astro";
import AboutMe from "../../components/sections/AboutMe.astro";
import Tool from "../../components/icons/Tool.astro";
import Hero from '../../components/sections/Hero.astro';
import Form from "../../components/icons/Form.astro";
import Technologies from "../../components/components/Technologies.astro";
import Title from '@/components/components/Title.astro';
import Experience from '@/components/sections/Experience.astro';
---

<Layout 
  title="Portafolio de trabajo de David Hernández - Desarrollador y Programador con 3 años de experiencia como desarrollador de software independiente."
  description="Portafolio web de trabajo de David Hernández, contrata David para crear tu sitio, app o plataforma web con tecnologias como HTML, CSS, JavaScript, Astro, React, IA entre otras más, con trabajo dedicado al detalle y visualmente atractivo, enfocado en conocer tu necesidad y visión de trabajo prpyectandola a tus clientes.">
	<main class="">
		<SectionContainer id="inicio" class="py-28">
			<Hero></Hero>
		</SectionContainer>

		<SectionContainer id="proyectos">
			<Title>../Proyectos/.</Title>
			<Projects>
			</Projects>
			
		</SectionContainer>

		<SectionContainer>
			<Title>Experiencia</Title>
			<Experience>
			</Experience>
		</SectionContainer>

		<SectionContainer id="sobre-mi">
			<Title>../Sobre mi/.</Title>
			<AboutMe>
			</AboutMe>
		</SectionContainer>

		<SectionContainer id="tecnologias" class="mt-20">
			<Title>../Stack Tecnológico/.</Title>
			<Technologies></Technologies>
		</SectionContainer>
	</main>
	
</Layout>

